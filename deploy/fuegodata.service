[Unit]
Description=FuegoData (Next.js: front + API)
After=network-online.target postgresql.service

[Service]
WorkingDirectory=/home/undefined_club/fuegodata/web/.next/standalone
EnvironmentFile=/home/undefined_club/fuegodata/web/.env.production
Environment=NODE_ENV=production
# Solo escucha en local: el público entra por Tailscale Funnel (HTTPS).
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=PATH=/home/undefined_club/.local/node/bin:/usr/bin:/bin
ExecStart=/home/undefined_club/.local/node/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
